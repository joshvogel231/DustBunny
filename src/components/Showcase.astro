---
/**
 * Homepage "Sites and Concepts" showcase.
 * One object per build. Nothing here labels a card as a client or a concept —
 * the section title carries that. Far From Home Bud's public name is new;
 * change `name` and `description` on that single entry when the wording shifts.
 */
const sites = [
  {
    id: "far-from-home",
    // Name and description for this card live only in this entry.
    name: "Far From Home Bud",
    description:
      "Houston dispensary and coffee lounge on Rankin Road — cannabis, a coffee bar, and a 21+ room open 24 hours.",
    tag: "Dispensary & Coffee · Houston",
    href: "https://top-flight.netlify.app/",
    chrome: "Far From Home Bud",
    image: "/work/far-from-home.webp",
    width: 840,
    height: 4191,
    alt: "Far From Home Bud website, a Houston dispensary and coffee lounge.",
  },
  {
    id: "texas-q",
    name: "Texas Q",
    description:
      "Houston craft barbecue from pitmaster Sloan Rinaldi — pecan-smoked meats, family recipes, and catering.",
    tag: "Craft BBQ · Houston",
    href: "https://texasq.netlify.app/",
    chrome: "Texas Q",
    image: "/work/texas-q.webp",
    width: 840,
    height: 5754,
    alt: "Texas Q website, from the pitmaster homepage through the menu and catering sections.",
  },
  {
    id: "florida-fishing",
    name: "Florida Fishing Guide",
    description:
      "Inshore, nearshore, and flats charters on Tampa Bay with Capt. Bo Hogan.",
    tag: "Fishing Charters · Tampa Bay",
    href: "https://florida-fishingguide.com/",
    chrome: "florida-fishingguide.com",
    image: "/work/florida-fishing.webp",
    width: 840,
    height: 4231,
    alt: "Florida Fishing Guide website for Capt. Bo Hogan's Tampa Bay charters.",
  },
  {
    id: "southern-creations",
    name: "Southern Creations Landscape & Design",
    description:
      "Tampa Bay landscape design, hardscaping, irrigation, and tree work built for the Florida yard.",
    tag: "Landscape · Tampa Bay",
    href: "https://southerncreationslandscape.com/",
    chrome: "southerncreationslandscape.com",
    image: "/work/southern-creations.webp",
    width: 840,
    height: 7261,
    alt: "Southern Creations Landscape & Design website, from the illustrated homepage through services and work.",
  },
  {
    id: "pcs",
    name: "Pipeline Chemical Solutions",
    description:
      "Bayou-born pipeline chemistry: cleaning, hydrotest prep, and proprietary blends operators run through the line.",
    tag: "Pipeline Chemicals · Gulf Coast",
    href: "https://effulgent-crepe-977bd1.netlify.app/",
    chrome: "Pipeline Chemical Solutions",
    image: "/work/pcs.webp",
    width: 840,
    height: 4822,
    alt: "Pipeline Chemical Solutions website, opening on a bayou pipeline and continuing through services.",
  },
  {
    id: "push-the-process",
    name: "Push the Process",
    description:
      "Competition prep and lifestyle coaching from Chris Massaro, with training and nutrition built around your goals.",
    tag: "Coaching · Competition Prep",
    href: "https://dashing-wisp-77f2cc.netlify.app/",
    chrome: "Push the Process",
    image: "/work/push-the-process.webp",
    width: 840,
    height: 4132,
    alt: "Push the Process coaching website, with Chris Massaro on the homepage.",
  },
  {
    id: "pcm",
    name: "Pipeline Construction & Maintenance",
    description:
      "Pipeline construction, maintenance, and integrity work for energy operators, headquartered in Houma.",
    tag: "Energy · Houma",
    href: "https://frolicking-sundae-3dbbf1.netlify.app/",
    chrome: "PCM",
    image: "/work/pcm.webp",
    width: 840,
    height: 5584,
    alt: "PCM website for pipeline construction, maintenance, and integrity services.",
  },
  {
    id: "vertex",
    name: "Vertex Contractors",
    description:
      "Site construction, land clearing, and demolition across Acadiana, based in Lafayette.",
    tag: "Site Work & Demolition · Acadiana",
    href: "https://helpful-seahorse-3cfd8f.netlify.app/",
    chrome: "Vertex Contractors",
    image: "/work/vertex.webp",
    width: 840,
    height: 3357,
    alt: "Vertex Contractors website for Acadiana site work, land clearing, and demolition.",
  },
];
---

<section id="work" class="border-y-4 border-ink halftone-mustard" aria-labelledby="sites-heading">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:py-20">
    <div class="mb-12 text-center">
      <div class="ink-2 inline-block rotate-1 bg-cream px-3 py-1 font-body text-sm font-800 uppercase tracking-wide shadow-comic-sm">
        Open a window
      </div>
      <h2 id="sites-heading" class="mt-4 font-impact text-4xl uppercase sm:text-5xl">Sites and Concepts</h2>
      <p class="mx-auto mt-3 max-w-xl font-body text-ink/80">
        Hover a window to roll through the page. Click it to open the live site.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 xl:grid-cols-3" data-stagger>
      {sites.map((site) => (
        <a
          class="showcase-card"
          href={site.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="showcase-chrome">
            <span class="showcase-dots" aria-hidden="true">
              <span class="showcase-dot bg-comic-red"></span>
              <span class="showcase-dot bg-mustard"></span>
              <span class="showcase-dot bg-teal"></span>
            </span>
            <span class="showcase-address">{site.chrome}</span>
          </div>
          <div class="showcase-viewport">
            <img
              class="showcase-shot"
              src={site.image}
              alt={site.alt}
              width={site.width}
              height={site.height}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="flex flex-1 flex-col px-4 py-4">
            <p class="font-body text-[11px] font-800 uppercase tracking-widest text-comic-red">{site.tag}</p>
            <h3 class="mt-1 font-impact text-2xl uppercase leading-none">{site.name}</h3>
            <p class="mt-2 font-body text-sm leading-snug text-ink/80">{site.description}</p>
            <span class="mt-3 inline-block font-body text-xs font-700 uppercase tracking-wide text-comic-red">
              Open site <span aria-hidden="true">→</span>
              <span class="sr-only"> (opens in a new tab)</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <script is:inline>
    (function () {
      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) return;
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      var section = document.getElementById("work");
      if (!section || !("IntersectionObserver" in window)) return;
      var cards = section.querySelectorAll(".showcase-card");
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-panning");
            io.unobserve(entry.target);
          });
        },
        { threshold: 0.72 }
      );
      cards.forEach(function (card) { io.observe(card); });
    })();
  </script>
</section>
