---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Mascot from "../components/Mascot.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Got it! — The Dust Bunny"
  description="Your message swept through. Josh will get back to you personally — usually within a day."
>
  <span id="top"></span>
  <Nav />

  <main id="main">
    <!-- ===================== CONFIRMATION HERO ===================== -->
    <section class="action-lines relative overflow-hidden border-b-4 border-ink">
      <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-20 md:grid-cols-[1fr_1fr] md:gap-12 md:py-24 lg:px-10">
        <div>
          <div class="ink-2 inline-block -rotate-2 bg-mustard px-3 py-1 font-body text-sm font-800 uppercase tracking-wide shadow-comic-sm">
            Form submitted
          </div>

          <h1 class="mt-4 font-impact text-5xl uppercase leading-[1.05] sm:text-6xl md:text-7xl">
            Message<br />
            <span class="ink-2 mt-3 inline-block -rotate-1 bg-comic-red px-3 pb-2 pt-1 leading-none text-cream shadow-comic-sm">
              swept up.
            </span>
          </h1>

          <p class="mt-6 font-body text-lg leading-relaxed text-ink/85">
            Got it. I'll review what you sent and respond <strong>personally</strong>
            — usually within a day, often a lot sooner.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/"
              class="sticker ink bg-comic-red px-7 py-3 font-display text-base uppercase text-cream shadow-comic"
            >
              Back to the homepage
            </a>
            <a
              href="/#work"
              class="sticker ink bg-cream px-7 py-3 font-display text-base uppercase shadow-comic"
            >
              See the work
            </a>
          </div>
        </div>

        <div class="relative flex justify-center md:justify-end">
          <div class="absolute inset-0 -z-10 m-auto h-64 w-64 rounded-full halftone-teal opacity-70 blur-[1px] md:right-8 md:left-auto lg:h-80 lg:w-80"></div>
          <Mascot class="w-72 drop-shadow-[8px_8px_0_rgba(26,23,20,0.25)] md:w-[24rem]" />
          <div class="speech ink absolute -right-2 top-2 max-w-[180px] rotate-3 bg-cream px-4 py-2 font-display text-sm shadow-comic-sm md:right-4">
            On it!
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== WHAT HAPPENS NEXT ===================== -->
    <section class="mx-auto max-w-3xl px-5 py-16">
      <div class="mb-10 text-center">
        <div class="ink-2 inline-block rotate-1 bg-teal px-3 py-1 font-body text-sm font-800 uppercase tracking-wide text-cream shadow-comic-sm">
          What happens next
        </div>
        <h2 class="mt-4 font-impact text-3xl uppercase sm:text-4xl">From here on out</h2>
      </div>

      <ol class="space-y-5">
        <li class="panel relative flex gap-5 p-6">
          <span class="process-step-num shrink-0">1</span>
          <div>
            <h3 class="font-display text-base uppercase">I read your message</h3>
            <p class="mt-1 font-body text-sm leading-relaxed text-ink/80">
              Every submission lands in my inbox — no team of account managers, no
              auto-responders. Just me.
            </p>
          </div>
        </li>
        <li class="panel relative flex gap-5 p-6">
          <span class="process-step-num shrink-0">2</span>
          <div>
            <h3 class="font-display text-base uppercase">You'll get a real reply</h3>
            <p class="mt-1 font-body text-sm leading-relaxed text-ink/80">
              Usually within a day, often within a few hours. We'll talk
              through what you need, what it'll cost, and when we can start.
            </p>
          </div>
        </li>
        <li class="panel relative flex gap-5 p-6">
          <span class="process-step-num shrink-0">3</span>
          <div>
            <h3 class="font-display text-base uppercase">If it's a fit, we kick off</h3>
            <p class="mt-1 font-body text-sm leading-relaxed text-ink/80">
              Questionnaire + mood board first, then a quick call to align,
              then 3–5 days to your first cut.
            </p>
          </div>
        </li>
      </ol>

      <p class="mt-8 text-center font-body text-sm text-ink/60">
        Didn't hear back within 24 hours? Check your spam folder, then hit me
        again — emails occasionally take a detour.
      </p>
    </section>
  </main>

  <Footer />
</Layout>
