---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Mascot from "../components/Mascot.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Page swept up — The Dust Bunny"
  description="Looks like that page got swept up in the dust. Back to the homepage you go."
>
  <span id="top"></span>
  <Nav />

  <main id="main">
    <section class="action-lines relative overflow-hidden">
      <div class="mx-auto grid max-w-5xl items-center gap-10 px-5 py-20 md:grid-cols-[1fr_1fr] md:gap-12 md:py-24 lg:px-10">
        <div>
          <div class="ink-2 inline-block -rotate-2 bg-mustard px-3 py-1 font-body text-sm font-800 uppercase tracking-wide shadow-comic-sm">
            404 — page not found
          </div>

          <h1 class="mt-4 font-impact text-6xl uppercase leading-[0.95] sm:text-7xl md:text-8xl">
            Looks like<br />
            that page<br />
            got <span class="ink-2 mt-3 inline-block -rotate-1 bg-comic-red px-3 pb-2 pt-1 leading-none text-cream shadow-comic-sm">swept up.</span>
          </h1>

          <p class="mt-6 max-w-md font-body text-lg leading-relaxed text-ink/80">
            The URL you tried doesn't exist (or doesn't exist anymore). My bad.
            Try one of these instead — they actually go somewhere.
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href="/"
              class="sticker ink bg-comic-red px-7 py-3 font-display text-base uppercase text-cream shadow-comic"
            >
              Back to the homepage
            </a>
            <a
              href="/#work"
              class="sticker ink bg-cream px-7 py-3 font-display text-base uppercase shadow-comic"
            >
              See the work
            </a>
          </div>
        </div>

        <div class="relative flex justify-center md:justify-end">
          <div class="absolute inset-0 -z-10 m-auto h-64 w-64 rounded-full halftone-teal opacity-70 blur-[1px] md:right-8 md:left-auto lg:h-80 lg:w-80"></div>
          <Mascot class="w-72 drop-shadow-[8px_8px_0_rgba(26,23,20,0.25)] md:w-[26rem] lg:w-[30rem]" />
          <div class="speech ink absolute -right-2 top-2 max-w-[180px] rotate-3 bg-cream px-4 py-2 font-display text-sm shadow-comic-sm md:right-4">
            Hmm. That's odd.
          </div>
        </div>
      </div>
    </section>

    <section class="border-y-4 border-ink halftone-mustard">
      <div class="mx-auto max-w-3xl px-5 py-14 text-center">
        <h2 class="font-impact text-2xl uppercase sm:text-3xl">Quick links</h2>
        <div class="mt-6 flex flex-wrap justify-center gap-3 font-body text-sm font-700 uppercase tracking-wide">
          <a href="/#services" class="ink-2 bg-cream px-4 py-2 hover:bg-cream/80">Services</a>
          <a href="/#work" class="ink-2 bg-cream px-4 py-2 hover:bg-cream/80">Recent Work</a>
          <a href="/#process" class="ink-2 bg-cream px-4 py-2 hover:bg-cream/80">Process</a>
          <a href="/about" class="ink-2 bg-cream px-4 py-2 hover:bg-cream/80">About</a>
          <a href="/faq" class="ink-2 bg-cream px-4 py-2 hover:bg-cream/80">FAQ</a>
          <a href="/#contact" class="ink-2 bg-cream px-4 py-2 hover:bg-cream/80">Contact</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
