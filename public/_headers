# Security headers for every response. Netlify reads this from the publish directory.
# The enforced CSP matches what the static site actually loads:
#   - same-origin pages, CSS, images
#   - Google Fonts stylesheets (fonts.googleapis.com) and font files (fonts.gstatic.com)
#   - inline scripts (every interaction is an inline script; there is no external JS)
#   - inline style attributes, plus the small <style> blocks Astro inlines for the
#     FAQ accordion and Geaux Tigers easter egg
#   - Netlify Forms, which POST to this origin (action="/thanks"), so form-action 'self'
#   - the deploy-preview drawer Netlify injects, which iframes https://app.netlify.com
#     (frame-ancestors stays 'none', so other sites still cannot frame this one)
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://app.netlify.com; worker-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self'; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; form-action 'self'; manifest-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
